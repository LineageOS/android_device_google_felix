<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">Համոզվեք, որ ձեր մատը ծածկում է սկաները</string>

    <!-- Message shown during fingerprint acquisision when the user removes their finger from the sensor too quickly -->
    <string name="fingerprint_acquired_too_fast">Մատը մի փոքր ավելի երկար պահեք սկաների վրա</string>

    <!-- Message shown during fingerprint acquisition when a Power press has been detected.[CHAR LIMIT=50] -->
    <string name="fingerprint_acquired_power_press">Շարունակեք կարգավորումը՝ թեթևակի հպելով սենսորին</string>

    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">Հաստատումն ավարտվեց։ Հաջորդ անգամ փորձեք թեթևակի հպել։</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">Dual Screen-ն անհասանելի է, քանի որ ձեր Pixel հեռախոսը գերտաքանում է</string>
</resources>
