<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">Đảm bảo ngón tay của bạn che cảm biến</string>

    <!-- Message shown during fingerprint acquisision when the user removes their finger from the sensor too quickly -->
    <string name="fingerprint_acquired_too_fast">Hãy giữ ngón tay trên cảm biến lâu hơn một chút</string>

    <!-- Message shown during fingerprint acquisition when a Power press has been detected.[CHAR LIMIT=50] -->
    <string name="fingerprint_acquired_power_press">Để tiếp tục thiết lập, hãy chạm nhẹ vào cảm biến</string>

    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">Đã kết thúc quy trình xác minh. Hãy thử chạm nhẹ vào lần tới.</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">Không bật được chế độ Màn hình đôi vì điện thoại Pixel của bạn quá nóng</string>
</resources>
