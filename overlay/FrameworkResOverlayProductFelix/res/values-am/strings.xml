    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">ማረጋገጫ አብቅቷል። በቀጣይ ጊዜ በትንሹ ለመንካት ይሞክሩ።</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">Pixel ስልክዎ በጣም እየሞቀ ስለሆነ Dual screen አይገኝም</string>
