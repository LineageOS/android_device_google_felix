    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">Растау аяқталды. Келесі жолы жайлап түртіп көріңіз.</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">Dual Screen функциясы істемейді, себебі Pixel телефоны қатты қызып кетеді.</string>
