<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">손가락이 센서 전체를 덮고 있는지 확인하세요</string>

    <!-- Message shown during fingerprint acquisision when the user removes their finger from the sensor too quickly -->
    <string name="fingerprint_acquired_too_fast">손가락을 센서에 좀 더 오랫동안 대고 기다리세요</string>

    <!-- Message shown during fingerprint acquisition when a Power press has been detected.[CHAR LIMIT=50] -->
    <string name="fingerprint_acquired_power_press">설정을 계속하려면 센서를 가볍게 터치하세요</string>

    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">인증이 중단되었습니다. 다음에는 가볍게 터치해 보세요.</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">Pixel 휴대전화 온도가 너무 높아지고 있으므로 Dual Screen을 사용할 수 없습니다.</string>
</resources>
