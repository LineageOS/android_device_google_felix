<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">Achte darauf, dass dein Finger den Sensor vollständig bedeckt</string>

    <!-- Message shown during fingerprint acquisision when the user removes their finger from the sensor too quickly -->
    <string name="fingerprint_acquired_too_fast">Halte deinen Finger etwas länger auf den Sensor</string>

    <!-- Message shown during fingerprint acquisition when a Power press has been detected.[CHAR LIMIT=50] -->
    <string name="fingerprint_acquired_power_press">Berühre zum Fortsetzen der Einrichtung den Sensor</string>

    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">Überprüfung beendet. Drücke beim nächsten Mal nicht so fest auf den Sensor.</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">Dual Screen ist nicht verfügbar, weil dein Pixel zu warm ist</string>
</resources>
