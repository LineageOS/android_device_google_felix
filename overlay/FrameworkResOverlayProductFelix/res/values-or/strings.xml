<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">ଆପଣଙ୍କର ଆଙ୍ଗୁଠି ସେନ୍ସରକୁ କଭର କରୁଥିବା ସୁନିଶ୍ଚିତ କରନ୍ତୁ</string>

