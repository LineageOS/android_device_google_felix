<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">اس بات کو یقینی بنائیں کہ آپ کی انگلی سینسر کو کور کرتی ہے</string>

    <!-- Message shown during fingerprint acquisision when the user removes their finger from the sensor too quickly -->
    <string name="fingerprint_acquired_too_fast">اپنی انگلی کو سینسر پر تھوڑی زیادہ دیر تک رکھیں</string>

    <!-- Message shown during fingerprint acquisition when a Power press has been detected.[CHAR LIMIT=50] -->
    <string name="fingerprint_acquired_power_press">سیٹ اپ جاری رکھنے کیلئے، سینسر کو ہلکے سے ٹچ کریں</string>

    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">تصدیق ختم ہو گئی۔ اگلی بار ہلکے سے ٹچ کرنے کی کوشش کریں۔</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">‏دوہری اسکرین دستیاب نہیں ہے کیونکہ آپ کا Pixel فون بہت زیادہ گرم ہو رہا ہے</string>
</resources>
