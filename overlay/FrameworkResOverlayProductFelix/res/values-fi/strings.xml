<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">Varmista, että sormesi peittää tunnistimen</string>

    <!-- Message shown during fingerprint acquisision when the user removes their finger from the sensor too quickly -->
    <string name="fingerprint_acquired_too_fast">Pidä sormesi anturin päällä vielä hetki</string>

    <!-- Message shown during fingerprint acquisition when a Power press has been detected.[CHAR LIMIT=50] -->
    <string name="fingerprint_acquired_power_press">Jatka käyttöönottoa koskettamalla tunnistinta</string>

    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">Vahvistus lopetettu. Kokeile koskettaa kevyesti ensi kerralla.</string>

    <!-- Content of concurrent display thermal notification. [CHAR LIMIT=NONE] -->
    <string name="concurrent_display_notification_thermal_content">Kaksoisnäyttö ei ole käytettävissä, koska Pixel-puhelin on liian lämmin</string>
</resources>
